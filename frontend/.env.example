# Copy this file to ".env" in the same folder. The copy is git-ignored.
#
# The frontend has NO secrets and needs no variables in production: the browser
# calls /api/... on its own domain and Vercel forwards those requests to the backend.
# Never put a secret in a frontend .env file - anything prefixed with VITE_ is
# compiled into the JavaScript that every visitor downloads.

# Development only: where the Vite dev server forwards /api requests.
# Change it only if the Go server runs on a different port than 8080.
API_PROXY_TARGET=http://localhost:8080
