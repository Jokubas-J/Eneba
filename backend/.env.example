# Copy this file to ".env" in the same folder and replace the fake values.
# ".env" is git-ignored. NEVER commit it and never paste its values into a chat.
# Full explanation of every variable: docs/setup.md
#
# Run the server and the tests from the backend/ folder so this file is found.

# --- Database (Neon) --------------------------------------------------------
# Use the DIRECT connection strings (connection pooling switched OFF in Neon's
# "Connect" dialog): the host name must NOT contain "-pooler".

# Neon branch "dev". In production (Render) this is the "main" branch instead.
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Neon branch "test". Automated tests WIPE this database - it must never be the
# same value as DATABASE_URL (the tests refuse to run if it is).
TEST_DATABASE_URL=postgresql://user:password@ep-example-654321.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Server -----------------------------------------------------------------
# "development" or "production". Production turns on the Secure cookie flag.
APP_ENV=development

# Port the Go server listens on. Render sets this itself in production.
PORT=8080

# Public address of the frontend, without a path or trailing slash. Requests that
# change something (login, register...) are only accepted from this origin.
# (Payment return URLs will use it too.)
APP_BASE_URL=http://localhost:5173

# --- Payments (read by the code from day 5) ---------------------------------
# "stripe" or "simulated".
PAYMENT_PROVIDER=simulated

# Stripe TEST-mode secret key (Stripe dashboard -> Developers -> API keys).
# Only keys starting with sk_test_ are ever used in this project.
STRIPE_SECRET_KEY=sk_test_replace_me

# Printed by: stripe listen --forward-to localhost:8080/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_replace_me
